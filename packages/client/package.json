{
  "name": "@freepeace13/inertia-live",
  "version": "0.0.0",
  "description": "Client for Inertia Live Projections.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./testing": {
      "types": "./dist/core/testing.d.ts",
      "import": "./dist/core/testing.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./vue/testing": {
      "types": "./dist/vue/testing.d.ts",
      "import": "./dist/vue/testing.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/testing": {
      "types": "./dist/react/testing.d.ts",
      "import": "./dist/react/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "peerDependencies": {
    "@inertiajs/react": "^2.0.0 || ^3.0.0",
    "@inertiajs/vue3": "^2.0.0 || ^3.0.0",
    "laravel-echo": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@inertiajs/react": "^2.3.28",
    "@inertiajs/vue3": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "laravel-echo": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@inertiajs/react": {
      "optional": true
    },
    "@inertiajs/vue3": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
