{
  "name": "@freepeace13/inertia-live",
  "version": "0.0.0",
  "description": "Client for Inertia Live Projections.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./testing": {
      "types": "./dist/core/testing.d.ts",
      "import": "./dist/core/testing.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./vue/testing": {
      "types": "./dist/vue/testing.d.ts",
      "import": "./dist/vue/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "peerDependencies": {
    "@inertiajs/vue3": "^2.0.0 || ^3.0.0",
    "laravel-echo": "^2.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^2.0.0",
    "laravel-echo": "^2.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "vue": "^3.4.0",
    "@biomejs/biome": "^2.0.0"
  }
}
