{
    "name": "freepeace13/inertia-live-projections",
    "description": "Live Inertia pages driven by Spatie Event Sourcing projections.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0",
        "inertiajs/inertia-laravel": "^2.0 || ^3.0",
        "spatie/laravel-event-sourcing": "^7.14"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "laravel/pint": "^1.18",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Freepeace13\\InertiaLive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freepeace13\\InertiaLive\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
