{
  "name": "@freepeace13/inertia-live-core",
  "version": "0.1.0",
  "description": "Framework-agnostic client for Inertia Live: subscribes to topic signals and reloads the affected props.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freepeace13/inertia-live.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/freepeace13/inertia-live/issues"
  },
  "homepage": "https://github.com/freepeace13/inertia-live/tree/main/packages/core#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "laravel-echo": "^2.0.0"
  },
  "devDependencies": {
    "laravel-echo": "^2.0.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {
    "laravel-echo": {
      "optional": true
    }
  }
}
